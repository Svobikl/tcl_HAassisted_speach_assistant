# TCL Android TV ADB address (HOST:PORT)
TCL_TV_ADB_TARGET=<TV_IP_ADDRESS>:5555

# Path to the patched Home Assistant Companion APK on the host
HA_APK_PATH=/usr/share/hassio/homeassistant/www/ha-companion-tv.apk

# Path to the provisioning state file
TCL_STATE_FILE=/usr/share/hassio/homeassistant/.tcl_tv_assistant_provisioned.json

# Local Faster-Whisper fallback HTTP daemon settings
WHISPER_HOST=localhost
WHISPER_PORT=8765
WHISPER_MODEL=base
WHISPER_LANGUAGE=cs
WHISPER_THREADS=4
